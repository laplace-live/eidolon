#!/bin/sh
# node for an MCP server where the computer has none: Eidolon's own binary as Node. The backend puts
# this folder last on the server's PATH, so a node the computer has comes first.
if [ -z "$EIDOLON_NODE" ]; then
  echo "node: EIDOLON_NODE isn't set: Eidolon sets it for the MCP servers it starts" >&2
  exit 1
fi
export ELECTRON_RUN_AS_NODE=1
exec "$EIDOLON_NODE" --disable-sigusr1 --use-system-ca "$@"
