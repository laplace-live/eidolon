# Keep the build context small. The Dockerfile uses targeted COPYs so
# most of these wouldn't end up in the image anyway, but excluding them
# at the daemon level speeds up `docker build` substantially when
# directories like .venv/ or vods/ are large.

.venv/
.ruff_cache/
__pycache__/
*.pyc
*.pyo
*.pyd

# Local secrets — never bake into images.
.env
.env.*
!.env.example

# Local-only working dirs (transcription scratch, downloaded VODs, etc.)
vods/
tools/__pycache__/

# Offline ingest artifacts: ~685MB of cached embedding vectors, plus a one-off
# Mem0 migration dump. `COPY ./data ./data` is not a targeted copy, so these
# ship unless excluded here; nothing reads them at runtime — the bot embeds
# each query fresh, and Mem0 reads Qdrant. CI images never had them (both are
# gitignored, so `actions/checkout` never fetches them).
data/embed_cache.db
data/mem0-cloud-export.json

# Tooling extras (faster-whisper etc.) live in optional deps; the
# runtime image installs only the default deps via `uv sync --no-dev`.

# Editor / OS junk
.DS_Store
.cursor/
.vscode/
.idea/

# Git
.git/
.gitignore

# TypeScript workspace
node_modules/
