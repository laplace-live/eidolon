#!/bin/sh
# The pnpx Eidolon bundles, for an MCP server where the computer has none.
if [ -z "$EIDOLON_NODE" ]; then
  echo "pnpx: EIDOLON_NODE isn't set: Eidolon sets it for the MCP servers it starts" >&2
  exit 1
fi
export ELECTRON_RUN_AS_NODE=1
exec "$EIDOLON_NODE" --disable-sigusr1 --use-system-ca "${0%/*}/../node_modules/pnpm/bin/pnpx.mjs" "$@"
