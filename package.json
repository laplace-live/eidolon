{
  "name": "laplace-eidolon-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "ORT_DISABLE_TELEMETRY=1 bun --watch apps/bot/src/main.ts",
    "start": "ORT_DISABLE_TELEMETRY=1 bun apps/bot/src/main.ts",
    "local": "node apps/bot/src/local/main.ts",
    "dev:local": "node --watch apps/bot/src/local/server.ts",
    "app": "[ -f apps/web/dist/index.html ] || bun run build:web && node apps/bot/src/local/main.ts --open",
    "dev:web": "bun run --cwd apps/web dev",
    "build:web": "bun run --cwd apps/web build",
    "i18n": "bun run --cwd apps/web i18n",
    "build:npm": "node apps/eidolon/scripts/build.ts",
    "pack:npm": "node apps/eidolon/scripts/build.ts --pack",
    "build:sdk": "bun packages/sdk/scripts/build.ts",
    "pack:sdk": "bun packages/sdk/scripts/build.ts --pack",
    "laplace-search": "node apps/cli/src/main.ts search",
    "laplace-eval-retrieval": "node apps/cli/src/main.ts eval-retrieval",
    "laplace-generate-image": "node apps/cli/src/main.ts generate-image",
    "gate-decisions": "node apps/cli/src/main.ts gate-decisions",
    "director-decisions": "bun docs/benchmarks/2026-11-10-director/score.ts --check",
    "review-decisions": "bun docs/benchmarks/2026-11-19-approve-for-me/score.ts --check",
    "laplace-download": "node apps/cli/src/main.ts download",
    "laplace-transcribe": "node apps/cli/src/main.ts transcribe",
    "laplace-refine": "node apps/cli/src/main.ts refine",
    "laplace-ingest-streams": "node apps/cli/src/main.ts ingest-streams",
    "laplace-ingest-facts": "node apps/cli/src/main.ts ingest-facts",
    "laplace-build-stream-catalog": "node apps/cli/src/main.ts build-stream-catalog",
    "laplace-pipeline": "node apps/cli/src/main.ts pipeline",
    "laplace-extract-users": "node apps/cli/src/main.ts extract-users",
    "laplace-prepare-batch": "node apps/cli/src/main.ts prepare-batch",
    "laplace-discover": "node apps/cli/src/main.ts discover",
    "laplace-task": "node apps/cli/src/main.ts task",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json && tsc -p packages/sdk/tsconfig.json && tsc -p packages/sdk/tsconfig.test.json && tsc -p apps/web/tsconfig.json && tsc -p apps/web/tsconfig.node.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "version": "changeset version && bun apps/bot/scripts/sync-version.ts",
    "release": "bun run build:npm && bun run build:sdk && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "undici": "7.30.2"
  }
}
