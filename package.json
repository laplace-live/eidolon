{
  "name": "laplace-eidolon-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --watch apps/bot/src/main.ts",
    "start": "bun apps/bot/src/main.ts",
    "local": "bun apps/bot/src/local/main.ts",
    "dev:local": "bun --watch apps/bot/src/local/server.ts",
    "app": "[ -f apps/web/dist/index.html ] || bun run build:web && bun apps/bot/src/local/main.ts --open",
    "dev:web": "bun run --cwd apps/web dev",
    "build:web": "bun run --cwd apps/web build",
    "i18n": "bun run --cwd apps/web i18n",
    "build:npm": "bun apps/eidolon/scripts/build.ts",
    "pack:npm": "bun apps/eidolon/scripts/build.ts --pack",
    "build:sdk": "bun packages/sdk/scripts/build.ts",
    "pack:sdk": "bun packages/sdk/scripts/build.ts --pack",
    "laplace-search": "bun apps/cli/src/main.ts search",
    "laplace-eval-retrieval": "bun apps/cli/src/main.ts eval-retrieval",
    "laplace-generate-image": "bun apps/cli/src/main.ts generate-image",
    "gate-decisions": "bun apps/cli/src/main.ts gate-decisions",
    "director-decisions": "bun docs/benchmarks/2026-11-10-director/score.ts --check",
    "laplace-download": "bun apps/cli/src/main.ts download",
    "laplace-transcribe": "bun apps/cli/src/main.ts transcribe",
    "laplace-refine": "bun apps/cli/src/main.ts refine",
    "laplace-ingest-streams": "bun apps/cli/src/main.ts ingest-streams",
    "laplace-ingest-facts": "bun apps/cli/src/main.ts ingest-facts",
    "laplace-build-stream-catalog": "bun apps/cli/src/main.ts build-stream-catalog",
    "laplace-pipeline": "bun apps/cli/src/main.ts pipeline",
    "laplace-extract-users": "bun apps/cli/src/main.ts extract-users",
    "laplace-prepare-batch": "bun apps/cli/src/main.ts prepare-batch",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/sdk/tsconfig.json && tsc -p packages/sdk/tsconfig.test.json && tsc -p apps/web/tsconfig.json && tsc -p apps/web/tsconfig.node.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test --no-env-file",
    "version": "changeset version && bun apps/bot/scripts/sync-version.ts",
    "release": "bun run build:npm && bun run build:sdk && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
