{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["apps/**", "packages/**", "*.json", "!**/node_modules", "!packages/retrieval/data"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@pipedog/*", "@pipedog/**"],
                "message": "Only packages/runtime may import pipedog; expose what you need through @eidolon/runtime."
              }
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["apps/bot/**", "packages/**", "!packages/ingest/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@eidolon/ingest": "The bot image skips builds for packages/ingest changes (docker.yml); drop that paths-ignore line before anything the bot loads imports it."
                },
                "patterns": [
                  {
                    "group": ["@pipedog/*", "@pipedog/**"],
                    "message": "Only packages/runtime may import pipedog; expose what you need through @eidolon/runtime."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/runtime/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@eidolon/ingest": "The bot image skips builds for packages/ingest changes (docker.yml); drop that paths-ignore line before anything the bot loads imports it."
                }
              }
            }
          }
        }
      }
    }
  ]
}
