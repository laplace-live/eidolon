{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "*.json",
      "!**/node_modules",
      "!packages/retrieval/data",
      "!apps/web/dist",
      "!apps/eidolon/pack",
      "!packages/sdk/pack"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "security": {
        "noDangerouslySetInnerHtml": "error"
      },
      "suspicious": {
        "noExplicitAny": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@eidolon/voice",
                  "@eidolon/voice/**",
                  "@eidolon/webrtc",
                  "@eidolon/webrtc/**"
                ],
                "message": "Only packages/runtime may import the voice engine and its transport; reach calls through @eidolon/runtime."
              }
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/bot/**",
        "!apps/bot/src/local/**",
        "!apps/bot/test/local/**",
        "packages/**",
        "!packages/ingest/**",
        "!packages/sdk/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@eidolon/ingest", "@eidolon/ingest/**"],
                    "message": "The bot image skips builds for packages/ingest changes (docker.yml); only apps/bot/src/local, which the image leaves out, may import it."
                  },
                  {
                    "group": ["@eidolon/cli", "@eidolon/cli/**"],
                    "message": "The bot image skips builds for apps/cli changes (docker.yml); only apps/bot/src/local, which the image leaves out, may import it."
                  },
                  {
                    "group": [
                      "@laplace.live/eidolon-sdk",
                      "@laplace.live/eidolon-sdk/**",
                      "**/sdk/src/**"
                    ],
                    "message": "The bot image skips builds for packages/sdk changes (docker.yml); server code never imports the browser SDK."
                  },
                  {
                    "group": [
                      "@eidolon/voice",
                      "@eidolon/voice/**",
                      "@eidolon/webrtc",
                      "@eidolon/webrtc/**"
                    ],
                    "message": "Only packages/runtime may import the voice engine and its transport; reach calls through @eidolon/runtime."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/bot/src/**", "!apps/bot/src/local/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@eidolon/ingest", "@eidolon/ingest/**"],
                    "message": "The bot image skips builds for packages/ingest changes (docker.yml); only apps/bot/src/local, which the image leaves out, may import it."
                  },
                  {
                    "group": ["@eidolon/cli", "@eidolon/cli/**"],
                    "message": "The bot image skips builds for apps/cli changes (docker.yml); only apps/bot/src/local, which the image leaves out, may import it."
                  },
                  {
                    "group": [
                      "@laplace.live/eidolon-sdk",
                      "@laplace.live/eidolon-sdk/**",
                      "**/sdk/src/**"
                    ],
                    "message": "The bot image skips builds for packages/sdk changes (docker.yml); server code never imports the browser SDK."
                  },
                  {
                    "group": [
                      "@eidolon/voice",
                      "@eidolon/voice/**",
                      "@eidolon/webrtc",
                      "@eidolon/webrtc/**"
                    ],
                    "message": "Only packages/runtime may import the voice engine and its transport; reach calls through @eidolon/runtime."
                  },
                  {
                    "group": ["**/local", "**/local/**"],
                    "message": "The image leaves apps/bot/src/local out: production code never imports the local entry."
                  },
                  {
                    "group": ["@eidolon/chat/jsonl", "@eidolon/chat/contract"],
                    "message": "Production keeps no transcripts: only apps/bot/src/local imports the JSONL chat store, and only tests the store contract. Production may import @eidolon/chat's main entry."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/runtime/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@eidolon/ingest", "@eidolon/ingest/**"],
                    "message": "The bot image skips builds for packages/ingest changes (docker.yml); only apps/bot/src/local, which the image leaves out, may import it."
                  },
                  {
                    "group": ["@eidolon/cli", "@eidolon/cli/**"],
                    "message": "The bot image skips builds for apps/cli changes (docker.yml); only apps/bot/src/local, which the image leaves out, may import it."
                  },
                  {
                    "group": [
                      "@laplace.live/eidolon-sdk",
                      "@laplace.live/eidolon-sdk/**",
                      "**/sdk/src/**"
                    ],
                    "message": "The bot image skips builds for packages/sdk changes (docker.yml); server code never imports the browser SDK."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/bot/src/local/**",
        "apps/bot/test/local/**",
        "apps/cli/**",
        "apps/eidolon/**",
        "packages/ingest/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@laplace.live/eidolon-sdk",
                      "@laplace.live/eidolon-sdk/**",
                      "**/sdk/src/**"
                    ],
                    "message": "Server, CLI, and offline packages never import the browser SDK."
                  },
                  {
                    "group": [
                      "@eidolon/voice",
                      "@eidolon/voice/**",
                      "@eidolon/webrtc",
                      "@eidolon/webrtc/**"
                    ],
                    "message": "Only packages/runtime may import the voice engine and its transport; reach calls through @eidolon/runtime."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/sdk/src/**", "!packages/sdk/src/react/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "bun": "Browsers import @laplace.live/eidolon-sdk: no Bun or Node modules.",
                  "react": "Keep the root @laplace.live/eidolon-sdk entry framework-agnostic; React bindings belong in src/react/."
                },
                "patterns": [
                  {
                    "group": ["bun:*", "node:*"],
                    "message": "Browsers import @laplace.live/eidolon-sdk: no Bun or Node modules."
                  },
                  {
                    "group": ["@eidolon/*", "@eidolon/**", "**/src/**", "**/apps/**"],
                    "message": "@laplace.live/eidolon-sdk publishes standalone to npm and never imports private @eidolon/* workspaces from src/."
                  },
                  {
                    "group": ["react/*", "react-dom", "react-dom/*", "**/react", "**/react/**"],
                    "message": "Keep the root @laplace.live/eidolon-sdk entry framework-agnostic; React bindings belong in src/react/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/sdk/src/react/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "bun": "Browsers import @laplace.live/eidolon-sdk: no Bun or Node modules."
                },
                "patterns": [
                  {
                    "group": ["bun:*", "node:*"],
                    "message": "Browsers import @laplace.live/eidolon-sdk: no Bun or Node modules."
                  },
                  {
                    "group": ["@eidolon/*", "@eidolon/**", "**/src/**", "**/apps/**"],
                    "message": "@laplace.live/eidolon-sdk publishes standalone to npm and never imports private @eidolon/* workspaces from src/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/chat/src/**", "!packages/chat/src/jsonl.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "bun": "Browsers import @eidolon/chat: only src/jsonl.ts, its own subpath export, may use Bun or Node."
                },
                "patterns": [
                  {
                    "group": ["bun:*", "node:*"],
                    "message": "Browsers import @eidolon/chat: only src/jsonl.ts, its own subpath export, may use Bun or Node."
                  },
                  {
                    "group": [
                      "@eidolon/*",
                      "@eidolon/**",
                      "@laplace.live/eidolon-sdk",
                      "@laplace.live/eidolon-sdk/**",
                      "**/sdk/src/**"
                    ],
                    "message": "Browsers import @eidolon/chat, so it imports no other package."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/**", "!apps/web/vite.config.ts", "!apps/web/**/*.test.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "bun": "The web app runs in the browser: no Bun or Node modules."
                },
                "patterns": [
                  {
                    "group": ["bun:*", "node:*"],
                    "message": "The web app runs in the browser: no Bun or Node modules."
                  },
                  {
                    "group": [
                      "@eidolon/*",
                      "@eidolon/**",
                      "!@eidolon/ingest/progress",
                      "!@eidolon/cli/job",
                      "!@eidolon/providers/catalog",
                      "!@eidolon/chat"
                    ],
                    "message": "The web app imports only the import-free leaves: @eidolon/ingest/progress and @eidolon/cli/job with `import type`, the provider catalog @eidolon/providers/catalog and the chat format @eidolon/chat; it gets everything else from the admin API."
                  },
                  {
                    "group": ["**/src/**", "!**/bot/src/local/api.ts"],
                    "message": "The web app reaches server code only through the wire types in apps/bot/src/local/api.ts, with `import type`."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDoubleEquals": "off"
          }
        }
      }
    }
  ]
}
