# laplace-eidolon — Environment Variables
# Copy this file to .env and fill in your API keys.
#
# Transport: SmallWebRTC only (self-hosted, signals via /api/offer on
# the dev runner's FastAPI server). No Daily or telephony env vars
# needed.
#
# Every non-secret setting here can also live in the data home's
# settings.yaml or a persona's persona.yaml, and every key in its
# credentials.json (docs/personas.md). A value set here wins over
# settings.yaml and credentials.json, but not over a persona's own
# persona.yaml: there it is the default for every persona that leaves the
# setting unset. TTS_VOICE_ID_<STYLE> and FISH_VOICE_ID_<STYLE> voices skip
# a persona with her own voice.voiceId.
#
# Every model this project runs is declared once, in the MODELS block
# directly below. The per-service sections further down explain the
# surrounding concern and point back to it.
#
# Syntax trap, and the reason this file looks the way it does:
# python-dotenv parses `KEY=  # note` as the literal value
# "# note" — a trailing comment only works after a real value. So every
# blank var here documents itself on the line ABOVE. Keep it that way,
# or a verbatim copy of this file ships garbage model IDs.


# ═════════════════════════════════════════════════════════════════════
# MODELS — every model, in one place
# ═════════════════════════════════════════════════════════════════════
# Blank = use the built-in default shown. Defaults live in code; the
# module that owns each one is named so you can confirm it hasn't moved.
#
# Each var appears exactly ONCE in this file. Don't re-declare one
# lower down: python-dotenv keeps the LAST occurrence, so a stray blank
# duplicate silently wipes whatever you set here.

# ── Providers: who fills each role (packages/providers) ──────────────
# docs/providers.md. Blank = the default shown, which is what this
# project ran before roles had providers, so an existing .env needs no
# change. Each names a provider's default account, configured by that
# provider's key and *_BASE_URL further down, or an account
# credentials.json adds (openai-2). A model or voice set here belongs to
# the provider set beside it, and a persona.yaml that picks another
# provider ignores it. The provider-named variables in this file
# (SONIOX_MODEL, OPENROUTER_MODEL, FISH_MODEL, FISH_VOICE_ID,
# SONIOX_ASYNC_MODEL) apply only while that provider fills the role, and
# the neutral names below win over them.

# Speech recognition: soniox, deepgram, elevenlabs or openai.
# Default: soniox
STT_PROVIDER=
# Default: the provider's (SONIOX_MODEL while Soniox hears)
STT_MODEL=
# The language viewers speak, ISO 639-1. Soniox detects it unless this is
# set; the others use it, else TRANSCRIBE_LANGUAGE, else zh.
STT_LANGUAGE=

# Chat: openrouter, anthropic, openai, google, deepseek, xai, qwen,
# moonshot, zhipu, ollama or openai-compatible. Claude or DeepSeek can run
# through OpenRouter (OPENROUTER_MODEL=anthropic/claude-sonnet-5.5) or on
# their own API (LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY).
# Default: openrouter
LLM_PROVIDER=
# Default: the provider's (OPENROUTER_MODEL while OpenRouter thinks)
LLM_MODEL=

# Speech: fish, elevenlabs, cartesia, minimax, openai or soniox. Fish
# Audio, ElevenLabs, Cartesia and Soniox stream over a WebSocket; MiniMax
# and OpenAI answer each sentence over HTTP, which adds a little latency
# per sentence. Delivery cues a model can't perform are taken out first.
# Default: fish
TTS_PROVIDER=
# Default: the provider's (FISH_MODEL while Fish speaks)
TTS_MODEL=
# The provider's voice id (FISH_VOICE_ID while Fish speaks); OpenAI's is a
# name such as marin. A style's voice is TTS_VOICE_ID_<STYLE>, as with
# FISH_VOICE_ID_<STYLE> below.
TTS_VOICE_ID=

# Experimental: one realtime model hears, thinks and speaks in place of the
# three above: openai or xai. Her voice styles and delivery cues don't
# apply, and recall works from the transcript the model returns.
# Default: off
REALTIME_PROVIDER=
# Default: the provider's
REALTIME_MODEL=
# Default: the provider's (marin on OpenAI, eve on xAI)
REALTIME_VOICE=

# Memory extraction: any chat provider; MEM0_LLM_MODEL is its model.
# Default: LLM_PROVIDER, with its model while the two match
MEM0_LLM_PROVIDER=
# Reranking: openrouter or cohere.
# Default: openrouter
RERANK_PROVIDER=
# The retrieval gate's decision model (Jev and the like): openrouter.
# Default: openrouter
RETRIEVAL_GATE_PROVIDER=
# Selfies: openrouter.
# Default: openrouter
SELFIE_PROVIDER=
# Embeddings, shared by every persona's index: openrouter, openai, google
# or openai-compatible. Changing it means re-running both ingests.
# Default: openrouter
EMBED_PROVIDER=
# Batch transcription: soniox.
# Default: soniox
TRANSCRIBE_PROVIDER=
# Default: the provider's (SONIOX_ASYNC_MODEL while Soniox transcribes)
TRANSCRIBE_MODEL=
# Transcript refinement: any chat provider; REFINE_MODEL is its model.
# Default: openrouter
REFINE_PROVIDER=

# ── Live voice pipeline (packages/runtime) ──────────────────────────

# Speech-to-text, Soniox realtime. STT_MODEL wins over it.
# Default: stt-rt-v5
SONIOX_MODEL=

# The persona LLM. Any OpenRouter slug. LLM_MODEL wins over it.
# Default: ~google/gemini-flash-latest
OPENROUTER_MODEL=

# Text-to-speech, Fish Audio. This sets synthesis quality only — the
# voice identity is FISH_VOICE_ID in the Fish Audio section below.
# TTS_MODEL wins over it.
# Default: drama-3
FISH_MODEL=

# ── Retrieval (packages/retrieval, packages/context/src/gate.ts) ─────

# Embedding model. Must match the model used at ingest time or vectors
# aren't comparable; changing it means re-ingesting both LanceDB tables.
# Default: google/gemini-embedding-2-preview
EMBED_MODEL=

# Output vector dim. Gemini supports 128–3072 via Matryoshka;
# recommended 768/1536/3072. Re-ingest both tables after changing.
# Default: 3072 (Gemini's full quality)
EMBED_DIM=

# Cross-encoder reranker model. Handles Chinese well; override only if
# you've validated alternatives.
# Default: cohere/rerank-4-fast
RERANK_MODEL=
# Override the rerank endpoint. Defaults to OpenRouter. Cohere's own API
# speaks the same request and response shape, so
#     RERANK_BASE_URL=https://api.cohere.com/v1
#     RERANK_API_KEY=<cohere key>
#     RERANK_MODEL=rerank-v4.0-fast
# reverts to billing Cohere directly with no code change — worth knowing,
# because OpenRouter's rerank route 429s on roughly half its calls where
# the same Cohere key direct went 8/8 (2026-09-07). The reranker retries
# those, which recovered 33/34 reranks across a full eval run, but the
# direct endpoint still costs half as much and needs no retry at all.
RERANK_BASE_URL=
# Override the rerank API key. Defaults to OPENROUTER_API_KEY.
# RERANK_BASE_URL and RERANK_API_KEY apply while RERANK_PROVIDER is
# unset or openrouter; another provider or account brings its own.
RERANK_API_KEY=
# Set to false/0/no/off to skip cross-encoder reranking entirely and use
# LanceDB's RRF fusion. On by default, since OPENROUTER_API_KEY is already
# required for the LLM — which means reranking now costs $0.002 per search
# on every deployment unless you turn it off here.
RERANK_ENABLED=

# Retrieval gate: TypeSafe's Jev decides whether a turn needs the LanceDB
# tables at all. Turns that ask nothing about the streamer skip both
# tables' embedding and rerank calls — ~4.7 s in a live call. The
# threshold was set on jev-1.13 and the alias moves with each release, so
# pin typesafe/jev-1.13 to keep that calibration, and re-run
# `bun run gate-decisions` before unpinning.
# Default: ~typesafe/jev-latest
RETRIEVAL_GATE_MODEL=
# Set to false/0/no/off to search both tables on every turn. On by default:
# it reuses OPENROUTER_API_KEY, costs ~$0.00001 per turn, and fails open —
# a slow or failing gate never makes a turn slower than searching alone.
RETRIEVAL_GATE_ENABLED=

# Chats in the local app (docs/chat.md); set these per persona in
# persona.yaml's chat section. In a group chat, the director, which asks
# the retrieval gate's model above who answers each line, weighs each
# persona by her interests and talkativeness.
# The topics she cares about, separated by commas or 、, e.g. 游戏、猫、深夜聊天.
# Default: none — the director reads her identity.summary alone.
CHAT_INTERESTS=
# How readily she joins in when no one addressed her, from 0 to 1.
# Default: 0.5
CHAT_TALKATIVENESS=
# How she answers in a chat: text, voice (a voice message in her TTS voice),
# or auto, where the director judges when a line suits a voice message. A
# chat's own setting overrides it; without a TTS key she answers in text.
# Default: auto
CHAT_REPLY_MODE=

# ── Offline batch chain (the laplace-* commands, packages/ingest) ────

# Transcript refinement, used by `laplace-refine` and `laplace-pipeline`.
# Overridable per-run with `--model`. Cheap multilingual alternatives:
# google/gemini-flash-latest, openai/gpt-4o-mini, anthropic/claude-haiku-latest.
# Default: ~google/gemini-pro-latest
REFINE_MODEL=

# Batch transcription, Soniox async, for `laplace-transcribe` and
# `laplace-pipeline` (their `--soniox-model` overrides it).
#
# The realtime SONIOX_MODEL above and this async one are different
# models on different endpoints; setting one does not affect the other.
# Default: stt-async-v5
SONIOX_ASYNC_MODEL=

# The language hint those transcriptions send Soniox (ISO 639-1, two
# letters; `--language` overrides it). `none` sends no hint.
# Default: zh
TRANSCRIBE_LANGUAGE=


# WebRTC ICE servers — required for any self-hosted deployment behind
# NAT (Docker bridge, VPS firewall, residential router). Leave ALL of
# these blank for local dev (browser ↔ localhost works via host
# candidates, no STUN/TURN needed).
#
# Without these in production, aiortc inside the container only knows
# its private IP (172.x.y.z) and offers it as the only candidate. The
# browser cannot route mic audio or SCTP back to that address, so
# you'll see TTS work (server → browser, via outbound NAT conntrack)
# while mic audio silently times out.
#
# Configuring a TURN URL also makes the server relay-only: it then
# advertises nothing but its TURN relay candidate, so the origin's public
# IP never reaches a viewer's SDP and every NAT type connects on the
# first candidate instead of the last. The trade is that all media is
# relayed — TURN becomes a hard dependency, and its bandwidth is billed.
# STUN-only deployments keep the old behavior.
#
# Two configuration paths — pick one:
#
# ── Path A: Cloudflare Realtime TURN (recommended) ──────────────────
#
# Dashboard → Realtime → TURN → Create TURN Key. Copy both values; the
# API token is shown only once.
#
# The bot mints fresh credentials on demand, caches them in-process for
# CLOUDFLARE_TURN_TTL_SEC seconds, and serves them to the frontend via
# GET /api/ice-servers. Set these two and never think about credential
# rotation again. Free up to ~1 TB/month relayed traffic.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=
# Optional. Credential lifetime in seconds (default 3600 = 1h). The bot
# refreshes 5 minutes before expiry so calls never hit a stale cred.
# Shorter = smaller blast radius if leaked; longer = fewer mint calls.
CLOUDFLARE_TURN_TTL_SEC=
#
# ── Path B: Static credentials (coturn, Twilio, manual, …) ─────────
#
# Used as a fallback when CLOUDFLARE_TURN_KEY_ID is unset. STUN-only
# (TURN URL blank) is fine if all users are on cone NATs. aiortc
# limitation: only ONE STUN and ONE TURN URL is honored — extras are
# silently dropped.
# e.g. stun:stun.cloudflare.com:3478
WEBRTC_STUN_URL=
# e.g. turn:turn.example.com:3478?transport=udp
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=


# Soniox (STT) — https://console.soniox.com/
# Model: SONIOX_MODEL, in the MODELS block above.
SONIOX_API_KEY=


# OpenRouter (LLM, OpenAI-compatible) — https://openrouter.ai/
# Model: OPENROUTER_MODEL, in the MODELS block above. This key is also
# the default for embeddings and refinement unless you override those
# with EMBED_API_KEY / REFINE_API_KEY.
OPENROUTER_API_KEY=

# OpenRouter's API base, for a proxy. Every OpenRouter role uses it.
# Default: https://openrouter.ai/api/v1
OPENROUTER_API_BASE=

# Attribution shown on the OpenRouter dashboard (HTTP-Referer / X-Title).
# Without them calls land in an anonymous bucket. Defaults:
# "LAPLACE Live!" and https://laplace.live/ai
OPENROUTER_APP_NAME=
OPENROUTER_APP_URL=


# Fish Audio (TTS) — https://fish.audio/app/
# Model: FISH_MODEL, in the MODELS block above.
FISH_API_KEY=
# Required: Fish Audio voice reference ID.
FISH_VOICE_ID=

# Optional alternative voices for the runtime ``change_voice_style`` tool.
# When the viewer asks the bot to switch styles in conversation
# ("声音温柔一点", "换个活泼的声音", "换回原来的"), the LLM picks the
# matching ``style`` from this list and the bot reconnects to Fish with
# the new reference_id mid-call. The suffix after ``FISH_VOICE_ID_`` is
# lowercased into the style enum value; ``default`` is reserved for
# ``FISH_VOICE_ID`` itself. Style names with built-in Chinese trigger
# hints (in packages/tools/src/voice.ts): ``gentle``, ``lively``,
# ``calm``, ``sweet``, ``playful``. Adding a new style without a hint
# still works — the LLM falls back to inferring from the bare name.
# They are moods of FISH_VOICE_ID: a persona whose persona.yaml sets her
# own voice.voiceId skips them, and has only her own voice.styles.
#
# Leave all of these blank to disable voice switching entirely; the
# tool isn't registered with the LLM in that case, so prompt tokens and
# behavior stay identical to a pre-feature deployment.
# Picked on "温柔一点" / "轻柔" / "柔和"
FISH_VOICE_ID_GENTLE=
# Picked on "活泼一点" / "营业声线" / "有活力"
FISH_VOICE_ID_LIVELY=


# Other providers (docs/providers.md) — set a key only for a provider a
# role above uses. These configure each provider's default account, the
# one a role means when it names the provider (LLM_PROVIDER=openai); a
# second account of a provider lives only in credentials.json's
# "accounts", which the local app's Settings → Providers adds and checks.
# Each *_BASE_URL moves the provider's API: blank uses its own.
#
# OpenAI: chat, speech recognition, speech, realtime and embeddings.
OPENAI_API_KEY=
# Default: https://api.openai.com/v1
OPENAI_BASE_URL=
# Anthropic (Claude), on its own API. Server-side fallbacks are on for the
# models that have them.
ANTHROPIC_API_KEY=
# Default: https://api.anthropic.com/v1
ANTHROPIC_BASE_URL=
# Google Gemini, through its OpenAI-compatible API.
GEMINI_API_KEY=
# Default: https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_BASE_URL=
DEEPSEEK_API_KEY=
# Default: https://api.deepseek.com
DEEPSEEK_BASE_URL=
# xAI (Grok): chat and realtime.
XAI_API_KEY=
# Default: https://api.x.ai/v1
XAI_BASE_URL=
# Qwen, on Alibaba Cloud Model Studio (DashScope).
DASHSCOPE_API_KEY=
# Default: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# (mainland China accounts: https://dashscope.aliyuncs.com/compatible-mode/v1)
DASHSCOPE_BASE_URL=
# Moonshot (Kimi).
MOONSHOT_API_KEY=
# Default: https://api.moonshot.ai/v1 (mainland China: https://api.moonshot.cn/v1)
MOONSHOT_BASE_URL=
# Zhipu (GLM).
ZHIPU_API_KEY=
# Default: https://api.z.ai/api/paas/v4 (mainland China: https://open.bigmodel.cn/api/paas/v4)
ZHIPU_BASE_URL=
# Ollama on your own machine, which takes no key and costs nothing.
# Default: http://localhost:11434/v1
OLLAMA_BASE_URL=
# Any other server with an OpenAI-compatible chat or embeddings API, such
# as LM Studio or vLLM. It has no default, so naming it as a provider needs
# the base, and its model named too.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
# ElevenLabs: speech recognition and speech.
ELEVENLABS_API_KEY=
# Deepgram: speech recognition.
DEEPGRAM_API_KEY=
# Cartesia: speech. Billed in plan credits, so its usage is recorded unpriced.
CARTESIA_API_KEY=
# MiniMax: speech.
MINIMAX_API_KEY=
# Default: https://api.minimax.io/v1 (mainland China: https://api.minimaxi.com/v1)
MINIMAX_BASE_URL=
# Sent with each request when set; some MiniMax accounts need it.
MINIMAX_GROUP_ID=
# Cohere: reranking on Cohere's own API (RERANK_PROVIDER=cohere).
COHERE_API_KEY=


# Usage ledger — a SQLite file where every call, job and MCP search records
# what each provider cost, for the local app's Usage page. A path that
# can't be written turns recording off with one warning. In Docker, point
# it at a writable volume: the mounted data home is read-only.
# Default: usage.db in the data home
EIDOLON_USAGE_DB=


# Selfies (the runtime ``take_selfie`` tool) — see docs/selfies.md
#
# When the viewer asks to see a photo ("拍张自拍", "让我看看你"), the LLM
# calls ``take_selfie``; the bot redraws these reference images through
# OpenRouter's image route using the built-in prompt in
# packages/imagegen/src/prompt.ts, then pushes the result's URL to the
# client as an RTVI ``server-message``. Billed per image on
# OPENROUTER_API_KEY above.
#
# On by default: with this blank, the references come from the persona's
# references/outfits/, which her template ships. Those are the
# same character in different outfits and are mutually exclusive — one is
# picked per render, the "night" one after dark — because two of her in one
# call makes the model draw two people. Empty the directory and the tool
# stops being registered at all.
#
# Set this only to override that — comma-separated local paths or http(s)
# URLs, replacing the bundled set rather than adding to it. The same rule
# applies to whatever is listed here: one of them reaches each render.
SELFIE_REFERENCE_IMAGES=
# Any OpenRouter slug whose model takes input_references. Defaults to
# openai/gpt-image-2.5-flare.
SELFIE_MODEL=
# One of: auto, 1:1, 3:2, 2:3, 4:3, 3:4, 16:9, 9:16, 21:9. Defaults to 3:4,
# which is selfie-shaped. Enum values are per-model; check
# /api/v1/images/models before changing the model above.
SELFIE_ASPECT_RATIO=
# One of: auto, low, medium, high, xhigh, max. Higher costs more and takes
# longer — the viewer is waiting on a live call. Defaults to auto.
SELFIE_QUALITY=
# How long a generated selfie stays fetchable at /api/selfie/<id>, in
# seconds. It is held in memory, so this also bounds what a busy stream
# costs in RAM. Defaults to 600.
SELFIE_TTL_SECONDS=
# Give up on a render after this many seconds. Defaults to 120.
SELFIE_TIMEOUT_SECONDS=


# Mem0 (long-term memory), self-hosted — https://docs.mem0.ai/open-source
# Note: leave a value blank to use the default. Do NOT add a trailing
# `# comment` after a blank value — python-dotenv would treat the comment
# as the value.
#
# Mem0 runs as a library inside the bot, with Qdrant holding the vectors;
# there is no Mem0 service to point at. Fact extraction uses the key of its
# provider (MEM0_LLM_PROVIDER, the chat provider by default) and
# embeddings reuse the EMBED_* block above, so those are the only
# credentials involved.

# Qdrant host — the one switch that enables memory. Leave blank to
# disable Mem0 entirely. `qdrant` is the service name in docker-compose;
# use `localhost` when running the bot outside Docker.
MEM0_QDRANT_HOST=
# Qdrant HTTP port; defaults to 6333.
MEM0_QDRANT_PORT=
# Collection holding the memory vectors; defaults to eidolon_memories.
# Qdrant fixes a collection's dimension at creation, so changing EMBED_DIM
# means using a new name here and letting viewers re-accumulate — old
# memory vectors aren't comparable to new ones.
MEM0_QDRANT_COLLECTION=
# SQLite file recording every add/update/delete Mem0 makes. Defaults to
# data/mem0/history.db; put it on a volume or it resets with the container.
MEM0_HISTORY_DB_PATH=
# Model that extracts facts out of each turn. Defaults to the chat model
# while memory uses the chat provider, else that provider's default. Runs
# on a background task, so a slower model costs money rather than latency.
MEM0_LLM_MODEL=
# Cloud API key. The bot never reads it; only the Python reference
# implementation's Mem0 export does, to dump a pre-migration account.
MEM0_API_KEY=
# DEPRECATED. The bot derives ``user_id`` from the validated
# Bilibili UID (see WORKERS_BASE_URL below). Anonymous viewers skip
# Mem0 entirely instead of sharing a ``default-user`` bucket. Kept here
# so older deployments don't break on a stale .env, but unused at
# runtime — leave blank.
MEM0_USER_ID=
# Optional identifier for the agent.
MEM0_AGENT_ID=
# Optional identifier for the conversation session.
MEM0_RUN_ID=
# Max memories per query; defaults to 10.
MEM0_SEARCH_LIMIT=
# Similarity threshold 0.0-1.0; defaults to 0.3.
MEM0_SEARCH_THRESHOLD=


# Viewer identity, rate limit, validation
# ─────────────────────────────────────────────────────────────────────
# The bot accepts an optional ``loginSyncToken`` in the WebRTC offer's
# ``requestData``. When present, it's validated against this Workers
# helper API, the resulting Bilibili profile drives a per-user Mem0
# namespace + a name-aware persona prefix, and the viewer bypasses the
# anonymous rate limit. When absent (or validation fails), the viewer
# is treated as anonymous: no Mem0, no name injection, and per-IP rate
# limit applies.
#
# Set WORKERS_BASE_URL in production; leave blank locally to disable
# token validation entirely (every viewer becomes anonymous).
# e.g. https://workers.vrp.moe
WORKERS_BASE_URL=

# Sent as the x-laplace-cf-waf-bypass header on every Workers request.
# Cloudflare's WAF 403s server-to-server calls without a browser-like
# fingerprint; the custom rule on the Workers side matches this value, so
# the two must stay in sync. Leave blank if no such rule is configured —
# otherwise token validation 403s and every viewer becomes anonymous.
# Read at client construction, so rolling it needs a bot restart.
CF_WAF_BYPASS_TOKEN=

# Per-IP sliding-window quota for anonymous /api/offer requests.
# Logged-in viewers bypass this. Defaults: 5 attempts per 3600s window.
EIDOLON_ANON_RATE_LIMIT_PER_HOUR=
EIDOLON_ANON_RATE_LIMIT_WINDOW_SEC=

# How long to cache a successful token→profile validation result
# in-process. Short enough to honor a fresh Bilibili sign-out, long
# enough to absorb WebRTC reconnect storms without re-hitting Workers.
# Default: 60 seconds.
EIDOLON_VALIDATE_TTL_SEC=

# Header to trust for the real client IP when running behind a proxy
# (e.g. ``cf-connecting-ip``, ``x-forwarded-for``, ``x-real-ip``).
# Leave blank for direct binds — falls back to ``request.client.host``.
# For X-Forwarded-For we take the first entry (the original client).
EIDOLON_REAL_IP_HEADER=

# Comma-separated browser origins allowed to call the bot (CORS), e.g.
# ``https://laplace.live``. Blank allows every origin.
PIPECAT_ALLOWED_ORIGINS=

# Serve Pipecat's built-in demo UI at / and /client. Off by default: that
# page has no rate limit, no Workers integration, and no persona theming,
# so both paths 404 unless this is true/1/yes/on. Turn it on to try the
# bot without a frontend. The TypeScript bot never serves the demo.
EIDOLON_PIPECAT_DEMO_ENABLED=


# Chat endpoint (text and voice messages for the web client)
# ─────────────────────────────────────────────────────────────────────
# The browser keeps each chat; the server keeps no transcript and signs
# what it adds with this key, so a browser can't forge a persona's lines.
# Off while blank: every chat route 404s as if it didn't exist. At least
# 32 characters, e.g. the output of `openssl rand -base64 32`. Environment
# only: credentials.json and settings.yaml never carry it. Rotating it
# drops the signed lines of every chat from what personas see next.
EIDOLON_CHAT_SECRET=

# Comma-separated persona ids the endpoint serves. Default: the installed
# persona (EIDOLON_PERSONA) alone.
EIDOLON_CHAT_PERSONAS=

# Chat turns (viewer lines) per hour. Anonymous viewers are counted per
# client IP (see EIDOLON_REAL_IP_HEADER), logged-in viewers per Bilibili
# UID. Defaults: 20 anonymous, 200 logged in. Read on the first turn, so
# a change needs a bot restart.
EIDOLON_CHAT_ANON_QUOTA=
EIDOLON_CHAT_USER_QUOTA=


# Voice engine
# ─────────────────────────────────────────────────────────────────────
# Experimental: which engine answers calls. pipedog is the pipeline every
# call runs on today; native is eidolon's own loop around the chat engine,
# over its own WebRTC transport (docs/voice-engine.md), for every call. Read
# once at boot; any other value runs pipedog with a warning.
# Default: pipedog
EIDOLON_VOICE_ENGINE=


# Audio quality / Opus encoder bitrate
# ─────────────────────────────────────────────────────────────────────
# The frontend can include ``audioQuality`` inside the WebRTC offer's
# ``requestData`` to pick a bitrate preset for the session, e.g.
#
#     requestData: { loginSyncToken: "...", audioQuality: "low" }
#
# Valid values: "best", "medium", "low", "lowest" (case-insensitive).
# Anything else (or no value) falls back to the operator default below
# with a warning log. The frontend cannot pass arbitrary integer
# bitrates — the preset whitelist bounds the worst case so a
# misbehaving client can't pin an outrageous bitrate per session.
#
# Defaults (kbps): best=192, medium=96, low=64, lowest=8. Override any
# preset here if the defaults don't match your bandwidth budget. Empty
# = use the built-in default. Note: lowest=8 kbps is below Opus's
# wideband threshold (~16 kbps), so the voice will sound noticeably
# compressed — useful as a "still-connected" fallback, not a target.
# default 192000 (audible vocal texture)
EIDOLON_OPUS_BITRATE_BEST_BPS=
# default 96000 (transparent for speech)
EIDOLON_OPUS_BITRATE_MEDIUM_BPS=
# default 64000 (toll quality)
EIDOLON_OPUS_BITRATE_LOW_BPS=
# default 8000 (narrowband; last-resort)
EIDOLON_OPUS_BITRATE_LOWEST_BPS=

# Operator-level fallback when the offer body has no ``audioQuality``
# (older JS clients, anonymous probes, etc.). Aligned with the
# ``medium`` preset (96 kbps) so missing-field traffic and
# explicit-medium traffic encode identically — and matches aiortc's
# own pre-patch default. Override here to pin a different fallback
# (e.g. `192000` to default everyone to ``best``). Practical range:
# 32000–256000.
# default 96000
EIDOLON_OPUS_BITRATE_BPS=


# The data home: settings.yaml, credentials.json, and each persona's own
# folder (her index, private references). Defaults to ~/.laplace/eidolon;
# both Docker images set /data. Read from the environment only.
EIDOLON_HOME=
# Which persona runs, by folder name. Defaults to settings.yaml's
# `persona`, then milky-green.
EIDOLON_PERSONA=
# What the persona calls you in the local web app's calls. The bot that
# `bun run start` and the Docker image run never reads it.
EIDOLON_LOCAL_VIEWER_NAME=
# EIDOLON_NO_DOTENV=1: the bot and the CLI skip the .env walk. Read from the process env, not .env.
# EIDOLON_APP_ROOT: set by the npm package's launcher to the installed package; never in a checkout.
# EIDOLON_BUN: a Bun binary the npm package's launcher runs instead of its own. Process env only.

# Persona file — defines who the bot IS (loaded as system_instruction).
# Relative to the repo root. Defaults to the persona's prompt.md.
PERSONA_FILE=

# IANA timezone used to inject "现在是 …" into the per-session system
# prompt prefix so the LLM can reason about time-sensitive persona
# lore (e.g. "early 2026"). Defaults to "Asia/Shanghai" because the
# default persona is Bilibili-based; override for forks targeting a
# different streamer locale (e.g. "America/Los_Angeles", "Asia/Tokyo").
# Falls back to UTC with a warning if the value is invalid or tzdata
# is missing (slim Docker images / Windows). Empty = use default.
PERSONA_TIMEZONE=


# Vector store + embeddings — shared across the stream archive and
# persona facts services. Both services live in the same LanceDB
# directory in separate tables (stream_chunks, persona_facts) and use
# the same embedding model so vectors are comparable across them.
#
# Model + dim: EMBED_MODEL / EMBED_DIM, in the MODELS block above.
#
# Build the indexes locally with:
#     bun run laplace-ingest-streams   # → stream_chunks.lance
#     bun run laplace-ingest-facts     # → persona_facts.lance
#
# Embeddings call OpenRouter's OpenAI-compatible /v1/embeddings endpoint.
# The OPENROUTER_API_KEY above is reused — no separate key needed.
# Pricing: ~$0.20/1M tokens, so a 4-hour transcribed stream embeds for
# under a cent; the ~3000 persona facts embed for ~$0.02 total.

# LanceDB index location (relative to the repo root). Defaults to the
# persona's index/ in the data home. The ingests write here too; given
# --persona, they stop when this is set and ask for --db-path, since the
# path may hold another persona's index.
LANCEDB_PATH=
# Override the embedding endpoint (e.g. point at OpenAI directly:
# https://api.openai.com/v1). Defaults to OpenRouter.
EMBED_BASE_URL=
# Override the embedding API key. Defaults to OPENROUTER_API_KEY above.
# Set this if your embedding provider differs from your LLM provider.
# EMBED_BASE_URL and EMBED_API_KEY apply while EMBED_PROVIDER is unset
# or openrouter; another provider or account brings its own.
EMBED_API_KEY=

# Hybrid retrieval — vector + Chinese FTS, optionally rescored by a
# cross-encoder reranker. Both PersonaFacts and StreamArchive use the
# same pipeline (packages/retrieval/src/hybrid.ts):
#
#   1. Build a search query from recent user turns (rescues short
#      voice utterances like "嗯, 那呢")
#   2. Embed it with EMBED_MODEL
#   3. Detect any date references and apply a SQL pre-filter on the
#      `date` column (persona_facts only)
#   4. Pull *_CANDIDATES rows via hybrid search (vector + jieba-
#      tokenized BM25 over a `tokens` column built at ingest time)
#   5. Unless RERANK_ENABLED is off, rerank with RERANK_MODEL down to
#      top_k. When off, fall back to LanceDB's default RRF fusion
#      (still better than vector-only at scale).
#
# The cross-encoder reranker is the single biggest precision lever
# above ~10k rows. Without it, hybrid search picks decent candidates
# but their order is noisy. Reranking goes through OpenRouter on the key
# the LLM already uses; see RERANK_MODEL above for the cost and for the
# knobs that repoint or disable it.
# Total candidates pulled per source before reranking. Larger = better
# recall but more reranker tokens spent. Defaults: facts=30, streams=15.
# These also set InputParams.candidates on the respective services.
PERSONA_FACTS_CANDIDATES=
STREAM_ARCHIVE_CANDIDATES=


# Video downloads — `laplace-download` and `laplace-pipeline` run yt-dlp.
# The TypeScript tools install and update their own copy in the data
# home's bin/; set this to run another binary instead.
YT_DLP_PATH=
# The browser yt-dlp reads login cookies from. Default: chrome. `none`
# reads no browser's cookies.
YT_DLP_COOKIES_FROM_BROWSER=
# A Netscape cookies.txt for yt-dlp to load. yt-dlp writes the merged
# cookie jar back into this file.
YT_DLP_COOKIES=


# Stream-transcript refinement — `laplace-refine`. Two-pass LLM
# pipeline that turns raw transcript output into structured memory
# records:
#
#   Pass 1 (extract):   transcript → JSON {sc_events, songs, events,
#                       promises, key_quotes, topics, mentions}
#   Pass 2 (synthesize): extract  → {heading, summary (1-2 sentences,
#                       embedded), details (8-15 sentence narrative,
#                       injected to LLM), chunk_type}
#
# Output is a `streams/<id>.refined.json` sidecar (schema_version: 2)
# that laplace-ingest-streams reads automatically. summary is what gets embedded
# (sharp retrieval); details + sc_events + key_quotes are what the
# bot sees at recall time (rich grounding so the persona can actually
# cite who sent which SC, etc.).
#
# Model: REFINE_MODEL, in the MODELS block above.
#
# Reuses OPENROUTER_API_KEY by default. Cost-bound: each run prints a
# per-file breakdown plus total tokens / USD. Pricing depends entirely
# on the model — measured at $0.04–0.08 per refined stream on
# google/gemini-2.0-flash-001. A pro-tier default costs materially
# more; check the printed total on your first run before batching.

# Max concurrent LLM calls per run. Each chunk runs 2 sequential calls
# under one slot, so 8 slots = up to 8 chunks in flight. Default: 8.
REFINE_CONCURRENCY=
# Override the refinement endpoint. Defaults to OpenRouter.
REFINE_BASE_URL=
# Override the refinement API key. Defaults to OPENROUTER_API_KEY above.
# REFINE_BASE_URL and REFINE_API_KEY apply while REFINE_PROVIDER is
# unset or openrouter; another provider or account brings its own.
REFINE_API_KEY=

# chunk_type values to skip from the LanceDB index (comma-separated).
# Default: "anime_audio,karaoke" — drop pure show-audio and song-lyric
# chunks because they're not memories of what the persona did. `none`
# keeps every chunk; blank means the default. `--skip-types ''` keeps
# every chunk for one run.
INGEST_SKIP_TYPES=


# Persona facts — RAG over hand-compiled streamer facts in the
# persona's facts folder, <data home>/sources/<id>/facts/. One atomic
# fact per line, optional date prefix. Built locally with:
#
#     bun run laplace-ingest-facts
#
# Lives in the SAME LanceDB instance as the stream archive (LANCEDB_PATH
# above), in a separate `persona_facts` table — so no extra path needed.
# Reuses the same embedding model + key as the stream archive (it must,
# because both query the same DB).
#
# This is a tier-2 persona layer:
#   tier 1: prompt.md        — always-on identity (~50-100 evergreen facts)
#   tier 2: persona_facts    — long-tail dated atomic facts (~3000)  ← this
#   tier 3: stream_chunks    — refined 5-min transcript scenes
#   tier 4: Mem0             — per-viewer episodic memory
#
# Disable by deleting persona_facts.lance from the persona's index/.

# Which files in the persona's facts folder hold facts, as
# comma-separated name patterns. Default: *.txt
FACTS_FILES=
# A regex, in Python's syntax, for the name that opens most facts
# ("明前奶绿声称…"), which the fact embeddings leave out. Default: the
# persona's identity.name.
FACTS_SUBJECT=

# --- Public MCP server (Streamable HTTP at /mcp) ---
# Read-only retrieval tools over the persona-facts + stream-archive indexes.
# Anonymous callers are rate-limited per client IP; callers presenting a valid
# loginSyncToken are limited per Bilibili UID at a higher ceiling.
EIDOLON_MCP_ANON_RATE_LIMIT_PER_HOUR=20
EIDOLON_MCP_AUTH_RATE_LIMIT_PER_HOUR=120
EIDOLON_MCP_RATE_LIMIT_WINDOW_SEC=3600
# Comma-separated Host allowlist for DNS-rebinding protection. Set to your
# public domain(s) behind the reverse proxy (e.g. eidolon.example.com). Leave
# empty to disable the Host check and rely on the proxy.
EIDOLON_MCP_ALLOWED_HOSTS=
