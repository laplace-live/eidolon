# pipecat-quickstart - Environment Variables
# Copy this file to .env and fill in your API keys

# Daily (Transport)
DAILY_API_KEY=
DAILY_ROOM_URL=  # Optional: leave empty to create a new room


# Soniox (STT) — https://console.soniox.com/
SONIOX_API_KEY=
SONIOX_MODEL=  # Optional: defaults to "stt-rt-v4"


# OpenRouter (LLM, OpenAI-compatible) — https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_MODEL=  # Optional: defaults to "openai/gpt-4o-2024-11-20"


# Fish Audio (TTS) — https://fish.audio/app/
FISH_API_KEY=
FISH_VOICE_ID=  # Required: Fish Audio voice reference ID
FISH_MODEL=  # Optional: defaults to "s2-pro"


# Mem0 (long-term memory) — https://app.mem0.ai/dashboard/api-keys
# Note: leave a value blank to use the default. Do NOT add a trailing
# `# comment` after a blank value — python-dotenv would treat the comment
# as the value.

# Required to enable persistent memory; leave blank to disable Mem0 entirely.
MEM0_API_KEY=
# Defaults to "default-user".
MEM0_USER_ID=
# Optional identifier for the agent.
MEM0_AGENT_ID=
# Optional identifier for the conversation session.
MEM0_RUN_ID=
# Max memories per query; defaults to 10.
MEM0_SEARCH_LIMIT=
# Similarity threshold 0.0-1.0; defaults to 0.3.
MEM0_SEARCH_THRESHOLD=
