# laplace-eidolon — Environment Variables
# Copy this file to .env and fill in your API keys.
#
# Transport: SmallWebRTC only (self-hosted, signals via /api/offer on
# the dev runner's FastAPI server). No Daily or telephony env vars
# needed.


# WebRTC ICE servers — required for any self-hosted deployment behind
# NAT (Docker bridge, VPS firewall, residential router). Leave ALL of
# these blank for local dev (browser ↔ localhost works via host
# candidates, no STUN/TURN needed).
#
# Without these in production, aiortc inside the container only knows
# its private IP (172.x.y.z) and offers it as the only candidate. The
# browser cannot route mic audio or SCTP back to that address, so
# you'll see TTS work (server → browser, via outbound NAT conntrack)
# while mic audio silently times out.
#
# Two configuration paths — pick one:
#
# ── Path A: Cloudflare Realtime TURN (recommended) ──────────────────
#
# Dashboard → Realtime → TURN → Create TURN Key. Copy both values; the
# API token is shown only once.
#
# bot.py mints fresh credentials on demand, caches them in-process for
# CLOUDFLARE_TURN_TTL_SEC seconds, and serves them to the frontend via
# GET /api/ice-servers. Set these two and never think about credential
# rotation again. Free up to ~1 TB/month relayed traffic.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=
# Optional. Credential lifetime in seconds (default 3600 = 1h). bot.py
# refreshes 5 minutes before expiry so calls never hit a stale cred.
# Shorter = smaller blast radius if leaked; longer = fewer mint calls.
CLOUDFLARE_TURN_TTL_SEC=
#
# ── Path B: Static credentials (coturn, Twilio, manual, …) ─────────
#
# Used as a fallback when CLOUDFLARE_TURN_KEY_ID is unset. STUN-only
# (TURN URL blank) is fine if all users are on cone NATs. aiortc
# limitation: only ONE STUN and ONE TURN URL is honored — extras are
# silently dropped.
WEBRTC_STUN_URL=  # e.g. stun:stun.cloudflare.com:3478
WEBRTC_TURN_URL=  # e.g. turn:turn.example.com:3478?transport=udp
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=


# Soniox (STT) — https://console.soniox.com/
SONIOX_API_KEY=
SONIOX_MODEL=  # Optional: defaults to "stt-rt-v4"


# OpenRouter (LLM, OpenAI-compatible) — https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_MODEL=  # Optional: defaults to "openai/gpt-4o-2024-11-20"


# Fish Audio (TTS) — https://fish.audio/app/
FISH_API_KEY=
FISH_VOICE_ID=  # Required: Fish Audio voice reference ID
FISH_MODEL=  # Optional: defaults to "s2-pro"


# Mem0 (long-term memory) — https://app.mem0.ai/dashboard/api-keys
# Note: leave a value blank to use the default. Do NOT add a trailing
# `# comment` after a blank value — python-dotenv would treat the comment
# as the value.

# Required to enable persistent memory; leave blank to disable Mem0 entirely.
MEM0_API_KEY=
# DEPRECATED. ``bot.py`` now derives ``user_id`` from the validated
# Bilibili UID (see WORKERS_BASE_URL below). Anonymous viewers skip
# Mem0 entirely instead of sharing a ``default-user`` bucket. Kept here
# so older deployments don't break on a stale .env, but unused at
# runtime — leave blank.
MEM0_USER_ID=
# Optional identifier for the agent.
MEM0_AGENT_ID=
# Optional identifier for the conversation session.
MEM0_RUN_ID=
# Max memories per query; defaults to 10.
MEM0_SEARCH_LIMIT=
# Similarity threshold 0.0-1.0; defaults to 0.3.
MEM0_SEARCH_THRESHOLD=


# Viewer identity, rate limit, validation
# ─────────────────────────────────────────────────────────────────────
# The bot accepts an optional ``loginSyncToken`` in the WebRTC offer's
# ``requestData``. When present, it's validated against this Workers
# helper API, the resulting Bilibili profile drives a per-user Mem0
# namespace + a name-aware persona prefix, and the viewer bypasses the
# anonymous rate limit. When absent (or validation fails), the viewer
# is treated as anonymous: no Mem0, no name injection, and per-IP rate
# limit applies.
#
# Set WORKERS_BASE_URL in production; leave blank locally to disable
# token validation entirely (every viewer becomes anonymous).
WORKERS_BASE_URL=  # e.g. https://workers.vrp.moe

# Per-IP sliding-window quota for anonymous /api/offer requests.
# Logged-in viewers bypass this. Defaults: 5 attempts per 3600s window.
EIDOLON_ANON_RATE_LIMIT_PER_HOUR=
EIDOLON_ANON_RATE_LIMIT_WINDOW_SEC=

# How long to cache a successful token→profile validation result
# in-process. Short enough to honor a fresh Bilibili sign-out, long
# enough to absorb WebRTC reconnect storms without re-hitting Workers.
# Default: 60 seconds.
EIDOLON_VALIDATE_TTL_SEC=

# Header to trust for the real client IP when running behind a proxy
# (e.g. ``cf-connecting-ip``, ``x-forwarded-for``, ``x-real-ip``).
# Leave blank for direct binds — falls back to ``request.client.host``.
# For X-Forwarded-For we take the first entry (the original client).
EIDOLON_REAL_IP_HEADER=


# Audio quality / Opus encoder bitrate
# ─────────────────────────────────────────────────────────────────────
# The frontend can include ``audioQuality`` inside the WebRTC offer's
# ``requestData`` to pick a bitrate preset for the session, e.g.
#
#     requestData: { loginSyncToken: "...", audioQuality: "low" }
#
# Valid values: "best", "medium", "low", "lowest" (case-insensitive).
# Anything else (or no value) falls back to the operator default below
# with a warning log. The frontend cannot pass arbitrary integer
# bitrates — the preset whitelist bounds the worst case so a
# misbehaving client can't pin an outrageous bitrate per session.
#
# Defaults (kbps): best=192, medium=96, low=64, lowest=8. Override any
# preset here if the defaults don't match your bandwidth budget. Empty
# = use the built-in default. Note: lowest=8 kbps is below Opus's
# wideband threshold (~16 kbps), so the voice will sound noticeably
# compressed — useful as a "still-connected" fallback, not a target.
EIDOLON_OPUS_BITRATE_BEST_BPS=    # default 192000 (audible vocal texture)
EIDOLON_OPUS_BITRATE_MEDIUM_BPS=  # default 96000  (transparent for speech)
EIDOLON_OPUS_BITRATE_LOW_BPS=     # default 64000  (toll quality)
EIDOLON_OPUS_BITRATE_LOWEST_BPS=  # default 8000   (narrowband; last-resort)

# Operator-level fallback when the offer body has no ``audioQuality``
# (older JS clients, anonymous probes, etc.). Aligned with the
# ``medium`` preset (96 kbps) so missing-field traffic and
# explicit-medium traffic encode identically — and matches aiortc's
# own pre-patch default. Override here to pin a different fallback
# (e.g. `192000` to default everyone to ``best``). Practical range:
# 32000–256000.
EIDOLON_OPUS_BITRATE_BPS=  # default 96000


# Persona file — defines who the bot IS (loaded as system_instruction).
# Path is resolved relative to server/. Defaults to "persona.md".
PERSONA_FILE=

# IANA timezone used to inject "现在是 …" into the per-session system
# prompt prefix so the LLM can reason about time-sensitive persona
# lore (e.g. "early 2026"). Defaults to "Asia/Shanghai" because the
# default persona is Bilibili-based; override for forks targeting a
# different streamer locale (e.g. "America/Los_Angeles", "Asia/Tokyo").
# Falls back to UTC with a warning if the value is invalid or tzdata
# is missing (slim Docker images / Windows). Empty = use default.
PERSONA_TIMEZONE=


# Vector store + embeddings — shared across the stream archive and
# persona facts services. Both services live in the same LanceDB
# directory in separate tables (stream_chunks, persona_facts) and use
# the same embedding model so vectors are comparable across them.
#
# Build the indexes locally with:
#     uv run python -m tools.ingest_streams   # → stream_chunks.lance
#     uv run python -m tools.ingest_facts     # → persona_facts.lance
#
# Embeddings call OpenRouter's OpenAI-compatible /v1/embeddings endpoint
# using google/gemini-embedding-2-preview by default. The OPENROUTER_API_KEY
# above is reused — no separate key needed. Pricing: ~$0.20/1M tokens, so a
# 4-hour transcribed stream embeds for under a cent; the ~3000 persona
# facts embed for ~$0.02 total.

# LanceDB index location (relative to server/). Defaults to "data/lancedb".
LANCEDB_PATH=
# Embedding model. Defaults to "google/gemini-embedding-2-preview". Must
# match the model used at ingest time, or vectors won't be comparable.
EMBED_MODEL=
# Output vector dim. Defaults to 3072 (Gemini's full quality). Gemini
# supports 128–3072 via Matryoshka; recommended 768/1536/3072. Re-ingest
# both tables after changing.
EMBED_DIM=
# Override the embedding endpoint (e.g. point at OpenAI directly:
# https://api.openai.com/v1). Defaults to OpenRouter.
EMBED_BASE_URL=
# Override the embedding API key. Defaults to OPENROUTER_API_KEY above.
# Set this if your embedding provider differs from your LLM provider.
EMBED_API_KEY=

# Hybrid retrieval — vector + Chinese FTS, optionally rescored by a
# cross-encoder reranker. Both PersonaFacts and StreamArchive use the
# same pipeline (laplace_eidolon/retrieval.py):
#
#   1. Build a search query from recent user turns (rescues short
#      voice utterances like "嗯, 那呢")
#   2. Embed it with EMBED_MODEL above
#   3. Detect any date references and apply a SQL pre-filter on the
#      `date` column (persona_facts only)
#   4. Pull *_CANDIDATES rows via hybrid search (vector + jieba-
#      tokenized BM25 over a `tokens` column built at ingest time)
#   5. If COHERE_API_KEY is set, rerank with rerank-v4.0-fast
#      down to top_k. If unset, fall back to LanceDB's default RRF
#      fusion (still better than vector-only at scale).
#
# The cross-encoder reranker is the single biggest precision lever
# above ~10k rows. Without it, hybrid search picks decent candidates
# but their order is noisy. Cohere offers a generous trial tier;
# production cost is roughly $1 / 1000 reranks.

# Cohere API key — https://dashboard.cohere.com/api-keys.
# Leave blank to skip cross-encoder reranking (uses RRF fusion).
# Strongly recommended at the current data scale (~30k chunks).
COHERE_API_KEY=
# Cohere reranker model. Defaults to "rerank-v4.0-fast", which
# handles Chinese well. Override only if you've validated alternatives.
COHERE_RERANK_MODEL=
# Total candidates pulled per source before reranking. Larger = better
# recall but more reranker tokens spent. Defaults: facts=30, streams=15.
# These also set InputParams.candidates on the respective services.
PERSONA_FACTS_CANDIDATES=
STREAM_ARCHIVE_CANDIDATES=


# Stream-transcript refinement — `tools/refine.py`. Two-pass LLM
# pipeline that turns raw Whisper output into structured memory records:
#
#   Pass 1 (extract):   transcript → JSON {sc_events, songs, events,
#                       promises, key_quotes, topics, mentions}
#   Pass 2 (synthesize): extract  → {heading, summary (1-2 sentences,
#                       embedded), details (8-15 sentence narrative,
#                       injected to LLM), chunk_type}
#
# Output is a `streams/<id>.refined.json` sidecar (schema_version: 2)
# that ingest_streams.py reads automatically. summary is what gets embedded
# (sharp retrieval); details + sc_events + key_quotes are what the
# bot sees at recall time (rich grounding so the persona can actually
# cite who sent which SC, etc.).
#
# Reuses OPENROUTER_API_KEY by default. Cost-bound: each run prints
# per-file breakdown plus total tokens / USD. Pricing depends on the
# model. With google/gemini-2.0-flash-001 (default), the two-pass
# approach is roughly $0.04–0.08 per refined stream — about 4× the
# old single-pass cost, but produces ~5× the detail.

# OpenRouter model slug for refinement. Default: google/gemini-2.0-flash-001.
# Other cheap multilingual options: google/gemini-flash-1.5-8b,
# openai/gpt-4o-mini, anthropic/claude-haiku-latest.
REFINE_MODEL=
# Max concurrent LLM calls per run. Each chunk runs 2 sequential calls
# under one slot, so 8 slots = up to 8 chunks in flight. Default: 8.
REFINE_CONCURRENCY=
# Override the refinement endpoint. Defaults to OpenRouter.
REFINE_BASE_URL=
# Override the refinement API key. Defaults to OPENROUTER_API_KEY above.
REFINE_API_KEY=

# chunk_type values to skip from the LanceDB index (comma-separated).
# Default: "anime_audio,karaoke" — drop pure show-audio and song-lyric
# chunks because they're not memories of what the persona did. Set to
# empty string to disable filtering.
INGEST_SKIP_TYPES=


# Persona facts — RAG over hand-compiled streamer facts in
# data/*设定集.txt + data/*事件集.txt. One atomic fact per line,
# optional date prefix. Built locally with:
#
#     uv run python -m tools.ingest_facts
#
# Lives in the SAME LanceDB instance as the stream archive (LANCEDB_PATH
# above), in a separate `persona_facts` table — so no extra path needed.
# Reuses the same embedding model + key as the stream archive (it must,
# because both query the same DB).
#
# This is a tier-2 persona layer:
#   tier 1: persona.md       — always-on identity (~50-100 evergreen facts)
#   tier 2: persona_facts    — long-tail dated atomic facts (~3000)  ← this
#   tier 3: stream_chunks    — refined 5-min transcript scenes
#   tier 4: Mem0             — per-viewer episodic memory
#
# Disable by deleting the persona_facts.lance subdir or by removing the
# data/*设定集.txt files before ingest.
